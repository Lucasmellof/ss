PUBLIC_IP=203.0.113.10
WS_RATE_LIMIT=30
MAX_WS_PER_IP=16

# Azure Trusted Signing (local Windows signing)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TRUSTED_SIGNING_ENDPOINT=https://eus.codesigning.azure.net/
AZURE_TRUSTED_SIGNING_ACCOUNT_NAME=signing
AZURE_TRUSTED_SIGNING_CERTIFICATE_PROFILE_NAME=Code-Signing

# Optional absolute paths when the tools are not available on PATH/auto-detected.
# SIGNTOOL_PATH=C:\Program Files (x86)\Windows Kits\10\bin\<version>\x64\signtool.exe
# AZURE_CODESIGNING_DLIB_PATH=C:\Program Files\Microsoft Artifact Signing Client Tools\Azure.CodeSigning.Dlib.dll
