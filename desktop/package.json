{
	"name": "screen-share-desktop",
	"version": "0.2.7",
	"private": true,
	"description": "Cliente desktop para compartilhamento de tela e áudio.",
	"homepage": "https://github.com/Lucasmellof/ss",
	"author": "Screen Share",
	"type": "module",
	"main": "dist-electron/main.js",
	"scripts": {
		"dev": "bun run build:electron && concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
		"build:ui": "vite build",
		"build:web": "cross-env BUILD_TARGET=web vite build",
		"build:electron": "tsc -p tsconfig.electron.json",
		"build": "bun run build:ui && bun run build:electron",
		"build:audio": "bun scripts/build-audio.mjs",
		"build:audio:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-audio-loopback.ps1",
		"lint": "oxlint src electron vite.config.ts electrobun.config.ts",
		"lint:fix": "oxlint --fix src electron vite.config.ts electrobun.config.ts",
		"format": "oxfmt --write \"src/**/*.ts\" \"src/**/*.tsx\" \"electron/**/*.ts\" \"electron/**/*.cts\" \"scripts/*.mjs\" vite.config.ts electrobun.config.ts package.json tsconfig.json tsconfig.electron.json components.json",
		"format:check": "oxfmt --check \"src/**/*.ts\" \"src/**/*.tsx\" \"electron/**/*.ts\" \"electron/**/*.cts\" \"scripts/*.mjs\" vite.config.ts electrobun.config.ts package.json tsconfig.json tsconfig.electron.json components.json",
		"dist": "bun scripts/dist.mjs",
		"dist:win": "bun run build:audio:win && bun run build && electron-builder --win portable nsis --publish never",
		"dist:linux": "bun run build && electron-builder --linux AppImage deb --publish never",
		"sign": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign-windows.ps1",
		"dist:signed": "bun run dist:win && bun run sign"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "latest",
		"@radix-ui/react-select": "latest",
		"@tanstack/react-router": "latest",
		"@tanstack/react-start": "latest",
		"class-variance-authority": "latest",
		"clsx": "latest",
		"electron-updater": "^6.8.9",
		"lucide-react": "latest",
		"radix-ui": "^1.6.7",
		"react": "latest",
		"react-dom": "latest",
		"tailwind-merge": "latest"
	},
	"devDependencies": {
		"@tailwindcss/vite": "latest",
		"@types/node": "latest",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@vitejs/plugin-react": "latest",
		"concurrently": "latest",
		"cross-env": "latest",
		"electron": "latest",
		"electron-builder": "latest",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"typescript": "latest",
		"vite": "latest",
		"wait-on": "latest"
	},
	"build": {
		"appId": "dev.lucas.screen-share",
		"productName": "Screen Share",
		"asar": true,
		"protocols": [
			{
				"name": "Screen Share Room",
				"schemes": [
					"screen-share-room"
				]
			}
		],
		"publish": [
			{
				"provider": "github",
				"owner": "Lucasmellof",
				"repo": "ss"
			}
		],
		"directories": {
			"output": "artifacts/electron-builder-release"
		},
		"win": {
			"icon": "resources/icon.ico",
			"target": [
				{
					"target": "portable",
					"arch": [
						"x64"
					]
				},
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			],
			"extraResources": [
				{
					"from": "build/audio-loopback/AudioLoopback.exe",
					"to": "tools/audio-loopback/AudioLoopback.exe"
				}
			]
		},
		"linux": {
			"icon": "resources/icon.png",
			"target": [
				{
					"target": "AppImage",
					"arch": [
						"x64"
					]
				},
				{
					"target": "deb",
					"arch": [
						"x64"
					]
				}
			],
			"category": "AudioVideo",
			"maintainer": "Screen Share <Lucasmellof@users.noreply.github.com>",
			"artifactName": "ScreenShare-${version}-${arch}.${ext}"
		},
		"portable": {
			"artifactName": "ScreenShare-${version}-portable.exe"
		},
		"nsis": {
			"oneClick": false,
			"perMachine": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"artifactName": "ScreenShare-Setup-${version}.exe"
		},
		"files": [
			"dist/**",
			"dist-electron/**",
			"tools/**",
			"resources/icon.png",
			"package.json"
		]
	},
	"desktopName": "screen-share"
}
